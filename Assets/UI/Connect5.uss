/* ─────────────────────────────────────────────
   Shared Connect5 styles
   ───────────────────────────────────────────── */

.hidden {
    display: none;
}

/* Reset Unity Button defaults globally so our styles take full control */
.btn-reset {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 0;
    margin: 0;
}
