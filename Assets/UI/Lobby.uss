/* ─────────────────────────────────────────────
   Connect5 – Lobby styles
   ───────────────────────────────────────────── */

/* ── Root ─────────────────────────────────── */
.lobby-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(10, 16, 32);
}

/* ── Left panel ───────────────────────────── */
.left-panel {
    width: 44%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgb(10, 16, 32);
}

/* ── Divider ──────────────────────────────── */
.divider {
    width: 1px;
    align-self: stretch;
    margin-top: 60px;
    margin-bottom: 60px;
    background-color: rgb(28, 50, 88);
}

/* ── Right panel ──────────────────────────── */
.right-panel {
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-left: 60px;
    padding-right: 60px;
}

/* ── Badge ────────────────────────────────── */
.badge {
    font-size: 11px;
    color: rgb(255, 212, 0);
    background-color: rgba(255, 212, 0, 0.15);
    border-radius: 4px;
    padding: 3px;
    padding-left: 14px;
    padding-right: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 14px;
    letter-spacing: 2px;
}

/* ── Title ────────────────────────────────── */
.title-label {
    font-size: 88px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.tagline {
    font-size: 16px;
    color: rgba(180, 190, 220, 0.8);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

/* ── Pieces preview ───────────────────────── */
.pieces-preview {
    flex-direction: row;
    margin-bottom: 36px;
    height: 20px;
}

.preview-dot {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    margin-left: 6px;
    margin-right: 6px;
}

/* ── Mode cards (main panel) ──────────────── */
.panel-main {
    flex-direction: row;
    margin-bottom: 0;
}

.mode-card {
    width: 200px;
    height: 124px;
    background-color: rgb(16, 28, 64);
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    margin-left: 10px;
    margin-right: 10px;
    border-width: 1px;
    border-color: rgba(50, 90, 160, 0.5);
    transition-property: background-color;
    transition-duration: 0.12s;
    cursor: link;
}

.mode-card:hover {
    background-color: rgb(26, 50, 110);
    border-color: rgba(100, 150, 240, 0.7);
}

.card-icon {
    font-size: 30px;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.card-title {
    font-size: 19px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 3px;
}

.card-desc {
    font-size: 11px;
    color: rgba(170, 185, 220, 0.85);
    -unity-text-align: middle-center;
    white-space: normal;
    width: 180px;
}

/* ── Sub panels (AI / Online / Create / Join) */
.panel-sub {
    flex-direction: column;
    align-items: center;
    width: 500px;
}

.sub-title {
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

/* ── Difficulty row ───────────────────────── */
.difficulty-row {
    flex-direction: row;
    margin-bottom: 20px;
}

.diff-btn {
    width: 148px;
    height: 60px;
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    background-color: rgb(16, 28, 64);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(50, 90, 160, 0.5);
    margin-left: 8px;
    margin-right: 8px;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.diff-btn:hover {
    background-color: rgb(26, 50, 110);
}

.diff-selected {
    background-color: rgb(190, 40, 40);
    border-color: rgb(239, 68, 68);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.diff-selected:hover {
    background-color: rgb(210, 50, 50);
}

/* ── Primary / Secondary buttons ──────────── */
.btn-primary {
    width: 480px;
    height: 64px;
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgb(190, 40, 40);
    border-radius: 8px;
    border-width: 0;
    margin-top: 8px;
    margin-bottom: 8px;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.btn-primary:hover {
    background-color: rgb(220, 55, 55);
}

.btn-secondary {
    width: 480px;
    height: 64px;
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    background-color: rgb(16, 28, 64);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(50, 90, 160, 0.6);
    margin-top: 8px;
    margin-bottom: 8px;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.btn-secondary:hover {
    background-color: rgb(26, 50, 110);
}

/* ── Create-room ──────────────────────────── */
.join-code {
    font-size: 62px;
    color: rgb(239, 68, 68);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
    letter-spacing: 6px;
}

.waiting-label {
    font-size: 18px;
    color: rgb(200, 210, 240);
    -unity-text-align: middle-center;
}

/* ── Join-room ────────────────────────────── */
.code-input {
    width: 480px;
    height: 60px;
    font-size: 18px;
    background-color: rgb(16, 28, 64);
    border-color: rgba(50, 90, 160, 0.5);
    border-width: 1px;
    border-radius: 6px;
    margin-bottom: 12px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.status-label {
    font-size: 15px;
    color: rgb(180, 200, 240);
    -unity-text-align: middle-center;
    margin-top: 8px;
}

/* ── Back / Error ─────────────────────────── */
.btn-back {
    width: 140px;
    height: 44px;
    font-size: 14px;
    color: rgba(180, 190, 220, 0.85);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-center;
    margin-top: 18px;
    transition-property: color;
    transition-duration: 0.1s;
}

.btn-back:hover {
    color: rgb(220, 230, 255);
}

.error-label {
    font-size: 14px;
    color: rgb(255, 100, 100);
    -unity-text-align: middle-center;
    margin-top: 6px;
    white-space: normal;
    width: 480px;
}

/* ── Online: name field ──────────────────── */
.name-field {
    width: 480px;
    height: 56px;
    font-size: 18px;
    background-color: rgb(16, 28, 64);
    border-color: rgba(50, 90, 160, 0.5);
    border-width: 1px;
    border-radius: 6px;
    color: rgb(255, 255, 255);
    margin-bottom: 16px;
    -unity-text-align: middle-left;
    padding-left: 16px;
}

/* ── Waiting room ─────────────────────────── */
.code-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
}

.btn-copy {
    height: 44px;
    font-size: 13px;
    color: rgba(180, 200, 240, 0.9);
    background-color: rgb(16, 28, 64);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(50, 90, 160, 0.5);
    margin-left: 10px;
    padding-left: 14px;
    padding-right: 14px;
    -unity-text-align: middle-center;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.btn-copy:hover { background-color: rgb(26, 50, 110); }

.players-vs-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
    margin-bottom: 16px;
}

.vs-label {
    font-size: 28px;
    color: rgba(180, 190, 220, 0.4);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-left: 14px;
    margin-right: 14px;
}

.room-card {
    width: 150px;
    align-items: center;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(16, 28, 64);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(50, 90, 160, 0.35);
}

.room-card-avatar {
    width: 68px;
    height: 68px;
    border-radius: 34px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
}

.room-card-avatar--p1    { background-color: rgb(239,  68,  68); }
.room-card-avatar--p2    { background-color: rgb(255, 212,   0); }
.room-card-avatar--empty {
    background-color: rgb(22, 36, 72);
    border-width: 2px;
    border-color: rgba(50, 90, 160, 0.25);
}

.avatar-initial {
    font-size: 26px;
    color: rgba(255, 255, 255, 0.92);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.avatar-initial--dim { color: rgba(100, 130, 200, 0.5); }

.room-card-name {
    font-size: 14px;
    color: rgb(220, 230, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
    overflow: hidden;
    white-space: nowrap;
    max-width: 130px;
}

.room-card-name--dim { color: rgba(130, 155, 210, 0.6); }

.room-card-badge {
    font-size: 9px;
    border-radius: 3px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.room-card-badge--host {
    background-color: rgba(239, 68, 68, 0.18);
    color: rgb(239, 68, 68);
}

.room-card-badge--guest {
    background-color: rgba(255, 212, 0, 0.18);
    color: rgb(200, 165, 0);
}

/* ── Mini board (left panel) ──────────────── */
.mini-board {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    width: 294px;
    height: 294px;
    background-color: rgb(20, 58, 148);
    border-radius: 10px;
}

.mini-cell {
    width: 38px;
    height: 38px;
    border-radius: 19px;
    margin: 2px;
    flex-shrink: 0;
    background-color: rgb(5, 10, 24);
    transition-property: background-color;
    transition-duration: 0.14s;
}

.mini-p1  { background-color: rgb(239, 68,  68); }
.mini-p2  { background-color: rgb(255, 212,  0); }
.mini-win { background-color: rgb(255, 255, 255); }
